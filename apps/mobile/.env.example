# ClauseLens 모바일 앱 환경 변수 — 복사해서 사용:  cp .env.example .env
# Expo는 이 파일(apps/mobile/.env)을 앱 루트에서 읽는다. 실제 값은 .env에만(gitignore).
# EXPO_PUBLIC_ 접두사 = JS 번들에 인라인되어 앱 코드에서 접근 가능(공개 값 전용).

# 백엔드 API 주소 (로컬 e2e = iOS 시뮬레이터에서 localhost 접근 가능)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# 카카오 네이티브 앱 키 (카카오 콘솔 > 내 앱 > 앱 키 > "네이티브 앱 키")
# client-public 식별자(앱에 박힘)라 EXPO_PUBLIC_ 사용. 단 커밋 금지 → .env 에만.
# config plugin(prebuild)과 initializeKakaoSDK(runtime) 양쪽에서 이 값을 사용.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key
