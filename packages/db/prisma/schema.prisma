// ClauseLens DB 스키마 (api·worker 공유의 단일 소스)
// DB = PostgreSQL. 로컬은 docker Postgres, 프로덕션은 Railway 관리형.

generator client {
  provider = "prisma-client-js"
  // 고정 경로에 생성 — pnpm의 peer 변형(typescript 버전별) 해싱과 무관하게 단일 위치.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 인증 (#32) ──

enum AuthProvider {
  KAKAO
  // Apple은 iOS 정식 출시 전 추가 예정(ADR 0008) → 그때 APPLE 값 마이그레이션.
}

model User {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String // provider 내 고유 id (카카오 회원번호)
  email          String?
  displayName    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  refreshTokens      RefreshToken[]
  documents          Document[]
  entitlement        Entitlement?
  entitlementCharges EntitlementCharge[]
  subscriptions      Subscription[]

  @@unique([provider, providerUserId])
}

// 불투명 refresh 토큰의 해시를 저장(회전·폐기 가능). 원문은 저장하지 않는다.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── 업로드/문서 (#15) ──

enum DocumentStatus {
  draft // presign 완료, 업로드 대기
  uploaded // 전체 페이지 업로드 확정
  analyzing // 분석 중(TASK-003)
  done // 전체 성공
  partial // 일부 성공·일부 실패(#16)
  failed
  expired // 세션 만료(정리 대상)
}

enum PageStatus {
  pending // 업로드/확정 전
  uploaded // 확정(finalKey 채택)
  // 실패는 영속 상태가 아니라 complete 응답의 error/retryable로 표현
}

// 보관 수명(analysis status와 직교한 축, #163). DELETING은 실삭제 잡(#164).
enum RetentionState {
  TEMPORARY // 무료 — retainUntil(완료+7일)로 접근 판정
  SAVED // 구독 저장 — 장기 보관(retainUntil 경과해도 유지)
  DELETING // 실삭제 진행 중(#164) — 비가역. documentVisible default-deny로 숨김
}

// 계약 세션 — 사용자가 분석하려는 페이지 묶음.
model Document {
  id              String         @id @default(cuid())
  userId          String
  clientRequestId String // 멱등키(첫 요청 전 클라 생성·영속)
  status          DocumentStatus @default(draft)
  expiresAt       DateTime       @db.Timestamptz(3) // 세션 만료(정리 기준). URL TTL과 분리
  completedAt     DateTime?      @db.Timestamptz(3) // terminal(done|partial) 최초 확정 시각. 1회 설정(연장 없음)
  retainUntil     DateTime?      @db.Timestamptz(3) // 재열람 보관 기한(completedAt+7일). 세션 TTL(expiresAt)과 분리 — 재열람 접근은 이 값으로 판정
  retentionState  RetentionState @default(TEMPORARY) // 보관 수명(#163). SAVED는 retainUntil 경과해도 노출
  savedAt         DateTime?      @db.Timestamptz(3) // SAVED 전환 시각(감사용 — 가시성은 여기서 파생하지 않음)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages        Page[]
  analysisJobs AnalysisJob[]

  @@unique([userId, clientRequestId]) // 멱등: 같은 사용자+요청키=같은 세션
  @@index([userId, status])
  @@index([userId, retainUntil, completedAt]) // 재열람 목록(소유자+보관 유효+완료순)
}

// 보관 만료 실삭제 감사 로그(#164). append-only — 행·랜덤 finalKey가 사라진 뒤 유일한 포렌식 흔적.
// 삭제 실행 전에 기록한다. FK 없음(대상 Document는 곧 삭제됨).
model DeletionAudit {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  reason     String // "free_expired" 등
  keys       String[] // 삭제 대상 S3 키 목록(finalKey·normalized·tmp)
  pageCount  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

// 문서의 개별 페이지. imageKey 대신 확정 후보키(finalKey)를 서버가 소유.
model Page {
  id           String     @id @default(cuid())
  documentId   String
  order        Int
  revision     Int        @default(1) // 교체/재분석은 TASK-007, 필드는 지금
  contentType  String
  expectedSize Int // presign 시 저장 → complete에서 실제 크기와 정확 일치 검증
  width        Int? // 클라 제공값(비신뢰, 참고). 실검증은 분석 단계(#16)
  height       Int?
  finalKey     String?    @unique // 확정된 후보키(copy 목적지). 확정 전 null
  status       PageStatus @default(pending)
  confirmedAt  DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  document        Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  analyses        PageAnalysis[]
  ocrResults      PageOcr[]
  analysisResults PageAnalysisResult[]

  @@unique([documentId, order])
}

// ── 분석 파이프라인 (#16 / TASK-003) ──
// 설계: agents/intent/specs/0020-analysis-request-polling.md
// job 모델 A(resumable 단일 job). DB = 접수·상태의 진실, 큐 = 실행 전달 수단.

enum AnalysisJobStatus {
  queued
  processing
  done // 전체 성공
  partial // 일부 성공·일부 실패
  failed // 전체 실패
}

enum PageAnalysisStatus {
  pending
  processing
  done
  failed
}

// 분석 실행 단위(문서당 순회 1개). id = 논리적 분석 요청 ID(멱등·과금 단위, 큐 전달 ID와 구분).
model AnalysisJob {
  id           String            @id @default(cuid())
  documentId   String
  status       AnalysisJobStatus @default(queued)
  totalPages   Int
  stateVersion Int               @default(1) // 상태변경 tx마다 ++ (페이지 상태만 바뀌어도). 역순 도착 방지
  dispatchedAt DateTime?         @db.Timestamptz(3) // 큐 전달 확인. 활성인데 미기록=미전달 후보(reconciler)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pages    PageAnalysis[]
  charge   EntitlementCharge?
  // 활성 job(queued|processing) 문서당 1개 = 부분 유니크 인덱스(마이그레이션 SQL로 추가).

  @@index([documentId, status])
}

// 페이지별 분석 상태·결과. 결과 본문(OCR 텍스트·boxes·조항)은 TASK-004에서 별 테이블.
model PageAnalysis {
  id          String             @id @default(cuid())
  jobId       String
  pageId      String
  revision    Int // 접수 시 Page.revision 스냅샷 = 확정 시 일치 기준(분석 중 교체 금지)
  status      PageAnalysisStatus @default(pending)
  errorCode   String? // 사용자용 오류 코드(원문 텍스트·PII 금지)
  retryable   Boolean            @default(false) // 사용자 재시도 가능 여부(자동 재시도 예산과 별개)
  attempts    Int                @default(0)
  confirmedAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  job  AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  page Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([jobId, pageId]) // 멱등 upsert 키
  @@index([pageId])
}

// ── OCR·위험조항 결과 (#68 / TASK-004 4a) ──
// 설계: agents/intent/specs/0021-ocr-risk-analysis.md
// 결과는 pageId+revision 귀속(재분석·다른 job에서도 동일). OCR=Vision 좌표, 분석=Claude 판단.

enum ClauseRiskLevel {
  high
  medium
  low
}

// OCR 정규화 결과 = 불변 체크포인트(pageId+revision). 재시도·재분석에서 재사용 → Vision 재호출 없음.
model PageOcr {
  id                   String   @id @default(cuid())
  pageId               String
  revision             Int
  engine               String // "gcv" (google cloud vision)
  normalizationVersion String // OCR 정규화 로직 버전(회귀 추적)
  inputFingerprint     String // finalKey + normalizationVersion (동일 입력 판정)
  orientation          String // "exif-normalized" — 좌표계 명시
  imageWidth           Int // upright 실측(EXIF 적용 후). 클라 제공 Page.width/height는 비신뢰
  imageHeight          Int
  blocks               Json // [{id,text,box:{x,y,width,height},confidence}] upright 픽셀, 읽기순
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, revision]) // 페이지·리비전당 1개(멱등 upsert 키)
}

// 분석 완료 마커 + provenance. 이 행 존재 = "이 revision 분석 완료"(정상 0건 vs 미저장 구분).
model PageAnalysisResult {
  id            String   @id @default(cuid())
  pageId        String
  revision      Int
  model         String // 실제 사용 모델 id
  promptVersion String
  schemaVersion String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  clauses Clause[]

  @@unique([pageId, revision])
}

// 위험 조항(Clause Result) — pageId+revision 귀속. PageAnalysisResult 단위로 교체.
model Clause {
  id          String          @id @default(cuid())
  resultId    String
  pageId      String
  revision    Int
  order       Int // 표시 순서(문서 위→아래)
  type        String // 분류 코드(auto_renewal 등), 미분류=other
  title       String
  description String
  riskLevel   ClauseRiskLevel
  sourceText  String // 판단 근거 원문(02 정책 "근거 원문 표시")
  boxes       Json // [{x,y,width,height}] upright 원본 픽셀(여러 블록 span 가능)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  result PageAnalysisResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([pageId, revision])
}

// ── 자격(무료 분석 횟수) 집행 (TASK-005 / #90) ──
// 설계: agents/intent/specs/0027-entitlement-enforcement/
// 정책(#79): done만 1회 차감 · partial/failed/invalid_image 무차감 · 멱등키 AnalysisJob.id · 사용자당 3회.
// 집행: 접수 시 예약(freeReserved++) → terminal에서 done=확정(consumed) / 그 외=해제(released).

// 사용자별 무료 횟수 집계. 가용 = freeGranted - freeConsumed - freeReserved.
model Entitlement {
  userId       String   @id
  freeGranted  Int      @default(3) // 부여된 무료 횟수(정책값). 구독 우회는 TASK-006.
  freeConsumed Int      @default(0) // 확정 차감(done terminal)
  freeReserved Int      @default(0) // 진행 중 예약(접수~terminal). terminal에서 확정/해제로 0 복귀
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EntitlementChargeStatus {
  reserved // 접수 시 선점(한도 집행·동시성 방지)
  consumed // done terminal — 확정 차감
  released // partial/failed/stale/worker_failed terminal — 예약 해제(무차감)
}

// 분석 접수 승인 근거(TASK-006 #162) — 구독 월 쿼터 vs 무료. 접수 당시 고정(ADR-12).
enum ChargeSource {
  FREE // 무료 횟수(Entitlement 카운터)
  SUBSCRIPTION // 구독 월 쿼터(charge 행 수로 계산)
}

// 무료 횟수 원장(job당 1행 = 멱등키). settle은 status==reserved일 때만 작동 → 중복 완료 이벤트에 no-op.
model EntitlementCharge {
  jobId     String                  @id // 멱등키 = AnalysisJob.id (1 job = 최대 1 차감)
  userId    String
  status    EntitlementChargeStatus @default(reserved)
  source    ChargeSource            @default(FREE) // 접수 근거(#162): FREE=무료 카운터, SUBSCRIPTION=구독 월 쿼터
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  settledAt DateTime?               @db.Timestamptz(3) // consumed/released 확정 시각

  job  AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 구독 월 쿼터 집계용(source=SUBSCRIPTION·window 내 reserved|consumed 건수)
  @@index([userId, status])
  @@index([userId, source, createdAt])
}

// 구독(TASK-006 #162) — 장기 보관 권한 + 분석 월 쿼터의 근거. 실제 행 생성·검증은 결제 연동(#165).
// 상태는 공급자(IAP/RevenueCat) 동기화로 갱신. 무료 잔액(Entitlement)과 분리.
model Subscription {
  id               String               @id @default(cuid())
  userId           String
  platform         SubscriptionPlatform
  productId        String // 스토어 상품 id
  period           SubscriptionPeriod
  status           SubscriptionStatus   @default(active)
  externalId       String // 외부 구독 식별자(원본 구독 id)
  currentPeriodEnd DateTime             @db.Timestamptz(3)
  autoRenew        Boolean              @default(true)
  verifiedAt       DateTime             @db.Timestamptz(3) // 공급자 검증 시각
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId]) // 계정 간 중복 귀속 방지
  @@index([userId, status])
}

enum SubscriptionPlatform {
  APP_STORE
  PLAY
  TEST // 결제 연동 전 시드·테스트용
}

enum SubscriptionPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  active // 유효(결제 정상)
  grace // 결제 유예(여전히 접근 — ADR-06 삭제 유예 30일과 별개)
  expired // 만료(접근 없음)
}
