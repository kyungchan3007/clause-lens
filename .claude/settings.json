{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/trace.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/session-context.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/trace.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/recall-hook.mjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/guard.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/trace.mjs\"" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/trace.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/trace.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agents/harness/hooks/stop-check.mjs\"" }
        ]
      }
    ]
  }
}
