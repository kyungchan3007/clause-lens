# ClauseLens 로컬 개발 환경 변수 — 복사해서 사용:  cp .env.example .env
# 여기 값은 로컬 throwaway. 실제 비밀값은 절대 커밋하지 않는다(.env는 gitignore).

# ── PostgreSQL ──
POSTGRES_USER=clauselens
POSTGRES_PASSWORD=clauselens
POSTGRES_DB=clauselens
POSTGRES_PORT=5432
# NestJS(Prisma)가 사용할 연결 문자열
DATABASE_URL=postgresql://clauselens:clauselens@localhost:5432/clauselens

# ── Redis (BullMQ) ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── 인증 (Auth / JWT) ──
# 로컬 throwaway. 프로덕션은 강력한 랜덤값을 Railway env로 주입(로그·커밋 금지).
JWT_ACCESS_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
# 카카오 로그인은 앱이 access token을 보내고 서버가 /v2/user/me로 검증 → 서버 카카오 키 불필요.

# ── MinIO (로컬 개발용 S3 호환 스토리지) ──
# 로컬 전용. 프로덕션 스토리지는 Railway Storage Bucket(관리형 S3 호환) — 아래 S3_* 변수만 교체.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 앱/서버가 사용할 S3 호환 설정 (프로덕션은 Railway Bucket 접속정보로 교체)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clause-lens
S3_FORCE_PATH_STYLE=true

# ── 결제/구독 (RevenueCat, #165) ──
# 미설정이면 운영 결제 경로 비활성(UnconfiguredBillingProvider + 웹훅 전부 거부). 운영은 Railway env로 주입.
# REVENUECAT_SECRET_KEY 를 넣으면 활성 → AUTHORIZATION·PROJECT_ID 도 필수(없으면 부트 실패).
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_HMAC_SECRET=
REVENUECAT_PROJECT_ID=clause-lens
REVENUECAT_ENVIRONMENT=production
REVENUECAT_API_BASE=https://api.revenuecat.com
REVENUECAT_HTTP_TIMEOUT_MS=8000
REVENUECAT_WEBHOOK_TOLERANCE_SEC=300
# 상품ID→기간 덮어쓰기(JSON, 선택). 기본값은 코드의 DEFAULT_PRODUCT_PERIODS.
# REVENUECAT_PRODUCT_PERIODS={"clauselens_pro_monthly":"MONTHLY","clauselens_pro_yearly":"YEARLY"}
