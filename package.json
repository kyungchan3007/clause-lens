{
  "name": "clause-lens",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "mobile": "pnpm --filter @clause-lens/mobile",
    "check": "bash agents/harness/evals/checks.sh",
    "issue-link": "node agents/harness/evals/issue-link.mjs",
    "request": "node agents/harness/evals/request.mjs",
    "issue-sync": "node agents/harness/evals/issue-sync.mjs",
    "usage": "node agents/harness/usage/usage.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "metrics": "node agents/harness/metrics/metrics.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
